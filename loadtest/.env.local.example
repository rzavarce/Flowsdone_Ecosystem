# Servidor: LOCAL (docker-compose en esta máquina)
# Copiar a .env.local (gitignored): cp .env.local.example .env.local
#
# Los valores de ADMIN_API_KEY/EVOLUTION_API_KEY de acá abajo son los
# defaults de desarrollo que trae env.example.txt del repo — si tu .env
# local ya los rotaste, actualizalos acá también.

TARGET_BASE_URL=http://localhost:8000
ADMIN_API_KEY=ChangeMeAdminApiKey123!
LOADTEST_APIKEY=ChangeMeEvolutionApiKey123!
LOADTEST_INSTANCE=loadtest-instance-1

# Los scripts de chaos corren docker compose directo (sin SSH) cuando
# VPS_HOST no está seteado — dejalo vacío/comentado para local.
# VPS_HOST=
VPS_COMPOSE_DIR=..
