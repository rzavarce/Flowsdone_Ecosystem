# Servidor: VPS de producción
# Copiar a .env.vps (gitignored): cp .env.vps.example .env.vps
# Completar con los valores reales — nunca commitear este archivo.

TARGET_BASE_URL=https://platform.flowsdone.com
ADMIN_API_KEY=
LOADTEST_APIKEY=            # = EVOLUTION_API_KEY del .env del gateway en el VPS
LOADTEST_INSTANCE=loadtest-instance-1

# Necesarios para los scripts de chaos (SSH al VPS):
VPS_HOST=usuario@tu-vps
VPS_COMPOSE_DIR=/ruta/al/repo/en/el/vps
