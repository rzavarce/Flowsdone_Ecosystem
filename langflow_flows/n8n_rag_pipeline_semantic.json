      "id": "a1b2c3d4-e5f6-4789-a012-b3c4d5e6f702",
      "name": "Semantic Split (Langflow)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        400,
        128
      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const raw = item.json?.outputs?.[0]?.outputs?.[0]?.results?.text?.text;\n  if (!raw) {\n    throw new Error(\n      'No se pudo leer la respuesta de Langflow: ' + JSON.stringify(item.json).slice(0, 300)\n    );\n  }\n\n  let chunks;\n  try {\n    chunks = JSON.parse(raw);\n  } catch (e) {\n    throw new Error('La respuesta de Langflow no es JSON valido: ' + raw.slice(0, 300));\n  }\n\n  for (const chunk of chunks) {\n    results.push({ json: { text: chunk.text } });\n  }\n}\n\nreturn results;"
      },
      "id": "a1b2c3d4-e5f6-4789-a012-b3c4d5e6f703",
