    {
      "name": "Admin - Channel Connections",
      "description": "Los external_id usados acá (demo-facebook-page-id, etc.) tienen que coincidir EXACTO con los que mandan las requests de la carpeta \"Webhooks - *\" — ahí van hardcodeados en el body porque se firman con HMAC (no se pueden usar variables en un body firmado). Si los cambiás acá, cambialos también en el webhook correspondiente.",
      "item": [
        {
          "name": "Create Channel Connection - WhatsApp (Evolution)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('channelConnectionId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{projectId}}\",\n  \"agent_id\": \"{{agentId}}\",\n  \"channel_type\": \"whatsapp_evolution\",\n  \"external_id\": \"{{demoWhatsappInstance}}\",\n  \"credentials\": {}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/internal/admin/channel-connections",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "admin", "channel-connections"]
            }
          }
        },
