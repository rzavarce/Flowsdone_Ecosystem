FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock* ./
RUN pip install uv
RUN uv pip install --system --no-cache-dir .

COPY api_gateway ./api_gateway
COPY workers ./workers

# /app da workers.xxx; /app/api_gateway da app.xxx (el código de la
# app vive físicamente en api_gateway/app/ pero se importa sin ese
# prefijo, igual que en app/ mismo y en los tests - ver pyproject.toml).
ENV PYTHONPATH=/app:/app/api_gateway
ENV PYTHONUNBUFFERED=1

# El CMD se sobreescribe en docker-compose
CMD ["python", "-m", "workers.kafka.inbound.main"]