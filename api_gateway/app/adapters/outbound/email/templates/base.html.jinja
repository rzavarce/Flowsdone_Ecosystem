{# Shared layout for every transactional email. A template extends this and
   fills `content` with its own inline-styled blocks - email clients strip
   <style> blocks unpredictably, so every element below carries its own
   inline style rather than relying on CSS classes. #}
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}Flowsdone{% endblock %}</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f1f5f9;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="max-width:480px;width:100%;background-color:#ffffff;border-radius:16px;overflow:hidden;">
            <tr>
              <td style="padding:28px 32px 0 32px;">
                <span style="font-size:20px;font-weight:700;color:#0f172a;">Flows<span style="color:#14b8a6;">done</span></span>
              </td>
            </tr>
            <tr>
              <td style="padding:24px 32px 32px 32px;color:#334155;font-size:15px;line-height:1.6;">
                {% block content %}{% endblock %}
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px;background-color:#f8fafc;color:#94a3b8;font-size:12px;line-height:1.5;">
                {% block footer %}Este correo lo generó Flowsdone automáticamente. Si no esperabas este mensaje, puedes ignorarlo.{% endblock %}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
