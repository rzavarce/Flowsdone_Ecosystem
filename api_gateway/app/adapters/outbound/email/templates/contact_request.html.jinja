{# Context: name, email, company, phone, interest_label, message (see SendContactRequestUseCase). #}
{% extends "base.html.jinja" %}
{% block title %}Nuevo contacto desde flowsdone.com{% endblock %}
{% block content %}
  <p style="margin:0 0 16px 0;font-size:17px;font-weight:600;color:#0f172a;">Nuevo contacto desde la web</p>
  <p style="margin:0 0 20px 0;">Alguien ha escrito desde el formulario de flowsdone.com. Responde a este correo para contestarle directamente.</p>
  <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;margin:0 0 20px 0;font-size:14px;">
    <tr><td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Nombre</td><td style="padding:6px 0;color:#0f172a;">{{ name }}</td></tr>
    <tr><td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Email</td><td style="padding:6px 0;"><a href="mailto:{{ email }}" style="color:#0ea5a2;">{{ email }}</a></td></tr>
    {% if company %}<tr><td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Empresa</td><td style="padding:6px 0;color:#0f172a;">{{ company }}</td></tr>{% endif %}
    {% if phone %}<tr><td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Teléfono</td><td style="padding:6px 0;color:#0f172a;">{{ phone }}</td></tr>{% endif %}
    <tr><td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Le interesa</td><td style="padding:6px 0;color:#0f172a;">{{ interest_label }}</td></tr>
  </table>
  <p style="margin:0 0 8px 0;font-size:13px;font-weight:600;color:#64748b;">Mensaje</p>
  <p style="margin:0;padding:12px 16px;background:#f1f5f9;border-radius:12px;white-space:pre-wrap;color:#0f172a;">{{ message }}</p>
{% endblock %}
